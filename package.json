{
  "name": "decimen-optical-transfer",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Embeddable fountain-coded animated-QR file transfer — screen to camera, no network, optional end-to-end encryption.",
  "keywords": [
    "qr",
    "fountain-code",
    "luby-transform",
    "optical",
    "air-gap",
    "file-transfer",
    "web-component"
  ],
  "type": "module",
  "module": "./dist-lib/decimen-optical.js",
  "types": "./dist-lib/types/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/types/lib/index.d.ts",
      "import": "./dist-lib/decimen-optical.js"
    }
  },
  "files": [
    "dist-lib",
    "lib",
    "shared",
    "receive/worker.ts",
    "receive/roi.ts",
    "send/genworker.ts",
    "send/pacing.ts",
    "send/layout.ts"
  ],
  "sideEffects": [
    "./lib/index.ts",
    "./dist-lib/decimen-optical.js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "tsc && vite build --config vite.lib.config.ts && tsc -p tsconfig.types.json",
    "prepack": "npm run build:lib",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "playwright-core": "^1.62.1",
    "qrcode": "^1.5.4",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10",
    "zxing-wasm": "^2.0.0"
  }
}
